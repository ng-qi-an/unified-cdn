{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Unified CDN",
  "colors": {
    "primary": "#0ea5e9",
    "light": "#0ea5e9",
    "dark": "#0ea5e9"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Dashboard",
        "pages": [
          "dashboard/installation",
          "dashboard/deploying"
        ]
      },
      {
        "group": "API",
        "pages": [
          "api/authentication",
          {
            "group": "Files",
            "openapi": {
              "source": "./api/files/openapi.yaml",
              "directory": "api/files"
            },
            "pages": [
              "GET /files/{id}/view",
              "GET /files/{id}/get",
              "PATCH /files/{id}/rename",
              "DELETE /files/{id}/delete",
              "POST /files/upload",
              "DELETE /files/delete"
            ] 
          },
          {
            "group": "Grant codes",
            "openapi": {
              "source": "./api/grant-codes/openapi.yaml",
              "directory": "api/grant-codes"
            },
            "pages": [
              "POST /grant-codes/generate",
              "GET /grant-codes/get"
            ] 
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/light-icon.png",
    "dark": "/dark-icon.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Github",
        "href": "https://github.com/ng-qi-an/unified-cdn"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ng-qi-an/unified-cdn"
    }
  }
}
