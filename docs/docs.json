{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Unified CDN",
  "colors": {
    "primary": "#0ea5e9",
    "light": "#0ea5e9",
    "dark": "#0ea5e9"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "about"
        ]
      },
      {
        "group": "Dashboard",
        "pages": [
          "dashboard/demo",
          "dashboard/installation",
          "dashboard/deploying"
        ]
      },
      {
        "group": "API",
        "pages": [
          "api/authentication",
          {
            "group": "Files",
            "openapi": {
              "source": "./api/files/openapi.yaml",
              "directory": "api/files"
            },
            "pages": [
              "GET /files/get",
              "POST /files/upload",
              "DELETE /files/delete",
              "GET /files/{id}/view",
              "GET /files/{id}/get",
              "PATCH /files/{id}/rename",
              "DELETE /files/{id}/delete"
            ] 
          },
          {
            "group": "Grant codes",
            "openapi": {
              "source": "./api/grant-codes/openapi.yaml",
              "directory": "api/grant-codes"
            },
            "pages": [
              "POST /grant-codes/generate",
              "GET /grant-codes/get",
              "DELETE /grant-codes/delete"
            ] 
          }
        ]
      },
      {
        "group": "Node.js SDK",
        "sdk": {
          "format": "typedoc",
          "source": "sdk/node-js/typedoc.json",
          "directory": "sdk/node-js"
        },
        "pages": [
          "sdk/node-js/Introduction",
          {
            "group": "Classes",
            "expanded": true,
            "pages": [
              "sdk/node-js/classes/UnifiedCDN",
              "sdk/node-js/classes/UnifiedCDNFile"
            ]
          },
          {
            "group": "Client",
            "expanded": true,
            "pages": [
              "sdk/node-js/client/UnifiedCDNClient"
            ]
          },
          {
            "group": "Errors",
            "expanded": true,
            "pages": [
              "sdk/node-js/errors/APIError",
              "sdk/node-js/errors/InsufficientPermissionsError",
              "sdk/node-js/errors/InvalidConfigurationError",
              "sdk/node-js/errors/NotFoundError",
              "sdk/node-js/errors/RateLimitedError",
              "sdk/node-js/errors/UnauthorisedError",
              "sdk/node-js/errors/UnknownError"
            ]
          },
          {
            "group": "Handlers",
            "expanded": true,
            "pages": [
              {
                "group": "Next.js",
                "expanded": true,
                "pages": [
                  "sdk/node-js/handlers/nextjs/toNextHandler"
                ]
              }
            ]
          },
          {
            "group": "Type Aliases",
            "expanded": true,
            "pages": [
              "sdk/node-js/types/FlexibleAPI",
              {
                "group": "Next.js Handler Options",
                "expanded": true,
                "pages": [
                  "sdk/node-js/types/NextUnifiedCDNHandlerOptions",
                  "sdk/node-js/types/NextClientOptions",
                  "sdk/node-js/types/NextUploadsOptions",
                  "sdk/node-js/types/NextUploadsDataOptions",
                  "sdk/node-js/types/NextUploadsBeforeHook"
                ]
              },
              "sdk/node-js/types/RawUnifiedCDNFile",
              "sdk/node-js/types/RawUnifiedCDNGrantCode",
              "sdk/node-js/types/UnifiedCDNFileJSON"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/light-icon.png",
    "dark": "/dark-icon.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Github",
        "href": "https://github.com/ng-qi-an/unified-cdn"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ng-qi-an/unified-cdn"
    }
  }
}
