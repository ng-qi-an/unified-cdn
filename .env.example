OUTPUT_METHOD=node

# For Docker compose
IMAGE=unified-cdn
HOST_PORT=3000
MEM_LIMIT=512m # Max memmory for the instance
MEMSWAP_LIMIT=1g # Max memory + swap. To disable swap, set this to the same value as MEM_LIMIT.
# SECRETS
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
# AUTH SETTINGS
TRUSTED_ORIGINS=
NEXT_TELEMETRY_DISABLED=1

# MEMORY MANAGEMENT [ONLY APPLIES TO UPLOADS, SPECIFICALLY VIA HACKCLUB-CDN.] For more information, please read the docs.
UPLOAD_MAX_CONCURRENT=3 
# ^ Maximum number of concurrent uploads allowed. If you expect large files (multiple files >100mb in 1 request), while you have little memory available (e.g. 500mb), keep this value low so ur server wont crash.
UPLOAD_MEMORY_BUDGET_MB=450
# ^ Take note: This is NOT checked every chunk, and will not shave off users already connected to the server and uploading. This only prevents future uploads if the memory usage is already above this threshold. Manipulating concurrent requests is more important.